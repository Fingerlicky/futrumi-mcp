# Futrumi GraphQL endpoint. Defaults to production if unset.
FUTRUMI_GRAPHQL_URL=https://futrumi-prod-w7u56.ondigitalocean.app/graphql

# HTTP port the MCP server listens on.
PORT=8080

# info | debug
LOG_LEVEL=info

# Public deeplink base used in tool output. Falls back to https://futrumi.cz
FUTRUMI_DEEPLINK_BASE=https://futrumi.cz

# How many GraphQL candidates search_recommendations fetches before local semantic ranking.
SEMANTIC_CANDIDATE_LIMIT=120

# Optional. Enables the LLM concierge path when set. Without it, the CLI uses deterministic retrieval.
OPENAI_API_KEY=

# Optional. Defaults to gpt-5. Override when testing cheaper/faster models.
OPENAI_MODEL=gpt-5-mini

# Set to false to force deterministic concierge output even when OPENAI_API_KEY is present.
CONCIERGE_USE_LLM=true

# Tool-call loop limit for the LLM concierge.
CONCIERGE_MAX_TOOL_ROUNDS=4

# Set to false if LLM errors should fail instead of returning deterministic fallback.
CONCIERGE_FALLBACK_ON_LLM_ERROR=true

# Bounded conversation memory for the Telegram bot (LLM path only).
# How many recent messages (user+assistant combined) to replay as context.
CONCIERGE_HISTORY_MAX_MESSAGES=6
# Minutes of inactivity after which the next message starts a fresh context.
CONCIERGE_HISTORY_IDLE_MINUTES=30

# Telegram concierge bot. Create a bot via BotFather and put your own Telegram user id in the allowlist.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# Default local storage for Telegram offset and logs. Falls back to .concierge-data in the package cwd.
CONCIERGE_DATA_DIR=.concierge-data

# Long polling timeout in seconds.
TELEGRAM_POLL_TIMEOUT_SECONDS=45

# Keep true during setup so /whoami can reveal your id before the allowlist is configured.
TELEGRAM_WHOAMI_OPEN=true

# --- Hlasový concierge nad GPT-Live (src/live) ---

# Set to false to hide /live/* behind a 404 (e.g. on a shared deploy).
LIVE_ENABLED=true

# Responses backend model the Live session delegates tool work to.
LIVE_BACKEND_MODEL=gpt-5.6-luna

# Max concurrent Live sessions per process; further /live/session requests get 429.
LIVE_MAX_SESSIONS=3

# Hard cap on one call. After it the server sends session.close over the sideband.
LIVE_MAX_SESSION_SECONDS=600

# Comma-separated access codes required in the x-live-access-code header on
# /live/session*. Leave empty for local development (no gate).
LIVE_ACCESS_CODES=

# --- Gemini Live jako druhý voice provider (POST /live/session s provider=gemini) ---

# Google AI Studio API key. Bez něj vrací provider=gemini rovnou 503, server nespadne.
# Server ho ven nikdy nepouští — klientovi jde jen ephemeral token z authTokens.create.
GEMINI_API_KEY=

# Model, který se zamkne do ephemeral tokenu.
GEMINI_LIVE_MODEL=gemini-3.8-live

# Verze API pro ephemeral tokeny. Klient se musí připojit na stejnou; tokeny jsou
# zatím jen ve v1alpha, měň jen když je Google přesune.
GEMINI_API_VERSION=v1alpha

# --- Žebříček top_businesses ---

# Strop kandidátů, které tool projde před seřazením podle počtu doporučujících expertů.
TOP_BUSINESSES_CEILING=600

# Velikost jedné stránky při stahování kandidátů.
TOP_BUSINESSES_PAGE_SIZE=200
